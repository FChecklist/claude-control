+# function. Best-effort: a logging failure must never fail the review.
+SUPERVISOR_RESPONSE_TEXT=$(python3 -c "
+import json
+try:
+    with open('$TASK_DIR/supervisor-result.json') as f:
+        d = json.load(f)
+    print((d.get('result') or '')[:2000])
+except Exception:
+    pass
+")
