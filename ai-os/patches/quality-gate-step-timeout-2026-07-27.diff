   local name="$1"; shift
   local cmd="$*"
   local logfile
   logfile=$(mktemp)
-  eval "$cmd" > "$logfile" 2>&1
+  timeout -k 30 "$GATE_STEP_TIMEOUT_SECONDS" bash -c "$cmd" > "$logfile" 2>&1
