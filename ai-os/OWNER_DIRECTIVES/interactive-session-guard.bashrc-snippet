# Every time it is sourced it rewrites the wrapper scripts from scratch, so a
# fresh interactive shell always gets the guard exactly as committed here --
# no manual sync step, no drift between "deployed" and "committed".

_interactive_guard_dir="${INTERACTIVE_GUARD_DIR:-$HOME/.claude-interactive-session-guard.d}"
mkdir -p "$_interactive_guard_dir" 2>/dev/null

# --- shared helpers, sourced by both wrapper scripts below -----------------
cat > "$_interactive_guard_dir/_lib.sh" <<'LIB_EOF'
#!/bin/bash
# Shared helpers for the interactive-session write-gate wrapper scripts
# (git, gh) living alongside this file. Sourced by both; not meant to be
# executed directly. See interactive-session-guard.bashrc-snippet (the
# installer that writes this file) for the full design rationale.

# Real (non-wrapper) binary for $1 ("git"/"gh"): PATH search with this
# directory removed, so the wrapper never resolves to itself.
_interactive_guard_real_bin() {
    local name="$1" dir p rest=""
    dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local IFS=:
    for p in $PATH; do
        [ "$p" = "$dir" ] && continue
        rest="${rest:+$rest:}$p"
    done
    ( PATH="$rest" type -P "$name" )
}

# Path to the cgroup file to check for the real-worker signal. Hardcoded to
# the real, kernel-tracked /proc/self/cgroup -- unconditionally, with NO
# override of any kind: no config file, no environment variable, nothing
# read at runtime that could redirect this check anywhere else. ROUND 2
# shipped this as a read of a plain config file ("$guard_dir/_cgroup_path")
# sitting in the guard's own install directory; that file was writable by
# any interactive session, so it was a total bypass of the "kernel-verified"
# claim, not a test seam (reproduced live: 3 lines of shell, no root). An
# early round-3 draft replaced that file with an
# INTERACTIVE_GUARD_TEST_CGROUP_FILE environment-variable override instead
# -- which is the exact same bug class wearing a different hat (a runtime,
# externally-settable signal the production code path trusts) and was
# rejected before landing. There is no such variable, or anything like it,
# read here now. See tests/interactive_session_guard_test.sh for how the
# test harness simulates a matching worker cgroup WITHOUT any runtime
# override the shipped code reads (it patches a throwaway copy of this
# file's own source text, never the deployed/committed copy, and never via
# a file or env var this function consults).
_interactive_guard_cgroup_path() {
    printf '%s' /proc/self/cgroup
}

# [ROUND 4] Directory of real, currently-registered tasks, to cross-check a
# matching cgroup unit name against a REAL task rather than trusting the
# name pattern alone. Hardcoded, no override -- same reasoning as
# _interactive_guard_cgroup_path() above: any config file or environment
# variable this read would be an ordinary interactive shell's ticket to
# point this check at a directory of its own choosing containing a forged
# task.yaml, which would defeat the whole point of this check. See
# tests/interactive_session_guard_test.sh for how the test harness
# simulates fixture task data without any runtime override the shipped code
# reads (same source-patched-scratch-copy technique as the cgroup path).
_interactive_guard_tasks_dir() {
    printf '%s' /opt/veridian/ai-os/tasks
}

# All three signals required: (1) INVOCATION_ID -- the real env var systemd
# sets for every unit it launches; (2) this process's own real, kernel-
# tracked cgroup membership actually names a
# veridian-worker@*/veridian-supervisor@* systemd unit; (3) [ROUND 4] the
# task_id parsed out of that matching unit name (the text between `@` and
# `.service`) names a REAL, currently in_progress task --
# <tasks_dir>/<task_id>/task.yaml exists and its `status:` field reads
# in_progress. (1) alone is a plain env var and can be spoofed by anyone
# with `export INVOCATION_ID=anything`; (2) cannot be set by an env var --
# it comes from /proc/self/cgroup, which reflects the kernel's real process
# hierarchy -- but ROUND 4's audit could not prove that an ordinary
# interactive process is structurally unable to obtain a genuinely
# kernel-tracked cgroup whose NAME matches this pattern without actually
# being a real dispatched worker (see the ROUND 4 section above for exactly
# what was and was not verified live about `systemd-run --user
# --unit=veridian-worker@<fake>.service`); (3) closes that gap regardless of
# how a matching-but-fake cgroup name might be produced, because a forged
# unit's instance name is whatever the caller chose and has no
# corresponding real, in_progress task directory, whereas a genuine
# dispatched worker's unit is always named after the real task_id
# scripts/veridian-task.py just created.
_interactive_guard_is_real_worker_context() {
    [ -n "${INVOCATION_ID:-}" ] || return 1
    local cgroup_file cgroup_content task_id task_yaml
    cgroup_file="$(_interactive_guard_cgroup_path)"
    [ -r "$cgroup_file" ] || return 1
    cgroup_content="$(cat "$cgroup_file" 2>/dev/null)"
    [[ "$cgroup_content" =~ (veridian-worker|veridian-supervisor)@([^[:space:]/]+)\.service ]] || return 1
    task_id="${BASH_REMATCH[2]}"
    task_yaml="$(_interactive_guard_tasks_dir)/$task_id/task.yaml"
    [ -r "$task_yaml" ] || return 1
    grep -Eq '^status:[[:space:]]*"?in_progress"?[[:space:]]*$' "$task_yaml"
}

# gh: does this argv perform (or attempt) a PR merge -- either the direct
# subcommand or the equivalent raw API call? Callers must pass the argv with
# any leading global flags already stripped by
# _interactive_guard_gh_strip_globals() below, so $1/$2 here are always the
# real subcommand tokens regardless of how many recognized global flags
# preceded them in the original command line.
_interactive_guard_gh_is_merge() {
    if [ "$1" = "pr" ] && [ "$2" = "merge" ]; then
        return 0
    fi
    if [ "$1" = "api" ]; then
        shift
        local method="" path="" arg
        while [ $# -gt 0 ]; do
            arg="$1"
            case "$arg" in
                -X|--method) shift; method="$1" ;;
                -X*) method="${arg#-X}" ;;
                --method=*) method="${arg#--method=}" ;;
                -*) ;;
                *) [ -z "$path" ] && path="$arg" ;;
            esac
            shift
        done
        method="$(printf '%s' "$method" | tr '[:lower:]' '[:upper:]')"
        case "$method" in
            PUT|PATCH)
                case "$path" in
                    */pulls/*/merge) return 0 ;;
                esac
                ;;
        esac
    fi
    return 1
}

# [ROUND 4] gh: strip gh's real global flags from the front of a raw gh
# argv, so the subcommand-detection above always sees the real subcommand
# tokens regardless of how many recognized global flags preceded them.
# `-R`/`--repo` is gh's one real global repository-override flag -- per
# `gh <subcommand> --help`'s own INHERITED FLAGS listing and confirmed live
# against a real gh 2.45 install, it can precede the subcommand
# (`gh --repo OWNER/REPO pr merge ...` reproduced live in the round-4 audit
# that found this bug) even though gh's own root `gh --help` does not list
# it among its top-level FLAGS (gh re-parses `-R`/`--repo` per-subcommand
# rather than registering it as a literal root persistent flag, confirmed by
# `gh --repo OWNER/REPO --help` itself failing with "unknown flag: --repo"
# at the bare-root level while `gh --repo OWNER/REPO pr view 1` and
# `gh --repo OWNER/REPO pr merge ...` both work). Both `--repo value` /
# `--repo=value` / `-R value` / `-Rvalue` (attached short-flag form) are
# real, live-confirmed forms. `--help`/`--version` are gh's only other true
# root-level flags (`gh --help`'s own FLAGS section lists exactly these
# two).
_interactive_guard_gh_strip_globals() {
    _interactive_guard_gh_stripped=()
    local arg
    while [ $# -gt 0 ]; do
        arg="$1"
        case "$arg" in
            -R|--repo)
                shift 2
                ;;
            --repo=*)
                shift
                ;;
            -R?*)
                shift
                ;;
            --help|--version)
                shift
                ;;
            *)
                _interactive_guard_gh_stripped=("$@")
                return
                ;;
        esac
    done
}

# [ROUND 5] gh: resolve ONE level of a PERSISTENT gh alias -- an entry
# created by `gh alias set <name> '<expansion>'` (stored in gh's own config,
# not anything this guard controls). `_interactive_guard_gh_is_merge()`
# above only recognizes the literal `pr merge` / `api ... /pulls/*/merge`
# token forms; if the first (post-global-flag-strip) token is itself an
# alias name (e.g. `gh alias set mrg 'pr merge --merge --delete-branch'`
# then `gh mrg 1`), that check reports "not a merge" even though real gh
# expands it to an actual merge -- this is gh's equivalent of the git
# persistent-alias bypass above. Resolved the same way: ask the REAL gh
# binary what it knows via `gh alias list` (real, live-confirmed output
# format for gh 2.45: one alias per line, "<name>: <expansion>") rather than
# re-implementing gh's own alias storage/lookup.
#
# Only resolves ONE level: if the expansion is itself another alias name, or
# begins with `!` (a shell alias -- gh, like git, supports these; they run
# an arbitrary shell command, not a gh subcommand token), this function
# leaves the argv unchanged rather than guessing -- see KNOWN LIMITATIONS in
# the installer file for why both are disclosed as residual gaps.
#
# Call as: _interactive_guard_gh_resolve_persistent_alias <real-gh-bin>
# <post-global-strip argv...>. Sets _interactive_guard_gh_resolved (array)
# to the argv gh would actually run after one level of expansion (the
# expansion's tokens followed by the caller's remaining args), or the
# original argv unchanged if the first token is not a known, resolvable
# alias.
_interactive_guard_gh_resolve_persistent_alias() {
    local real_gh="$1"
    shift
    _interactive_guard_gh_resolved=("$@")
    [ $# -ge 1 ] || return
    local name="$1" line alias_name expansion
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        case "$line" in
            *:*)
                alias_name="${line%%:*}"
                expansion="${line#*: }"
                ;;
            *)
                continue
                ;;
        esac
        if [ "$alias_name" = "$name" ]; then
            # Real `gh alias list` (confirmed live against gh 2.45) wraps
            # the expansion in a single quote pair ONLY when it begins with
            # "!" (its own shell-alias display convention) -- e.g.
            # `shellmrg: '!gh pr merge 1 --merge'` vs the unquoted
            # `mrg: pr merge --merge` for a plain alias. Strip that quoting
            # before checking for the "!" shell-alias marker, or the check
            # below would miss it (the raw stored value has no such quotes;
            # this is purely a `gh alias list` display artifact).
            case "$expansion" in
                \'*\') expansion="${expansion#\'}"; expansion="${expansion%\'}" ;;
            esac
            case "$expansion" in
                ''|'!'*)
                    # empty (malformed) or a shell alias -- cannot be
                    # resolved to a gh subcommand token; leave unresolved
                    # (see KNOWN LIMITATIONS).
                    return
                    ;;
            esac
            local expansion_tokens=($expansion)
            shift
            _interactive_guard_gh_resolved=("${expansion_tokens[@]}" "$@")
            return
        fi
    done < <("$real_gh" alias list 2>/dev/null)
}

# [ROUND 4] git: is $1 one of git's real no-argument global boolean flags?
# Per `man git`'s SYNOPSIS/OPTIONS for this git version, confirmed live
# against a real git 2.43 install.
_interactive_guard_git_global_noarg() {
    case "$1" in
        -v|--version|-h|--help|-p|--paginate|-P|--no-pager|--no-replace-objects|--bare|--no-optional-locks|--literal-pathspecs|--glob-pathspecs|--noglob-pathspecs|--icase-pathspecs|--html-path|--man-path|--info-path)
            return 0
            ;;
    esac
    return 1
}

# [ROUND 4] git: scan the FULL `git <args...>` argv (everything after the
# "git"/wrapper name itself, i.e. NOT including it) and skip past every
# recognized real global flag that can precede the subcommand, so the
# guard's subcommand check sees the actual subcommand token regardless of
# how many global flags (`git -C /tmp push ...`, `git --git-dir=/tmp/.git
# push ...`, both reproduced live in the round-4 audit that found this bug)
# came before it. Sets _interactive_guard_subcommand (the real subcommand,
# "" if none found), _interactive_guard_subcommand_args (argv after the
# subcommand), and _interactive_guard_global_prefix (the global-flag tokens
# that were skipped, in original form -- needed so a bare `git push` whose
# current-branch resolution depends on -C/--git-dir/--work-tree can still
# resolve the right branch; see the git wrapper script below).
#
# Confirmed live against a real git 2.43 install: `-C <path>` and
# `-c <name>=<value>` only accept a SPACE-separated value (an attached form
# like `-C/tmp` or `-cfoo=bar` is rejected by git itself with "unknown
# option") -- so only the space form is handled here. The long options
# (--git-dir, --work-tree, --namespace, --config-env, --list-cmds,
# --attr-source, --exec-path) each accept EITHER `--opt value` or
# `--opt=value` -- both handled. Bare `--exec-path` (no `=`) takes no
# separate following argument and is a print-and-exit action in real git (it
# never reaches any subcommand at all) -- treated here as consuming zero
# following args, which matches real git's own behavior.
#
# [ROUND 5] Also sets _interactive_guard_git_oneshot_alias (1 if a one-shot
# `-c alias.<name>=<value>` or `--config-env alias.<name>=<ENVVAR>` /
# `--config-env=alias.<name>=<ENVVAR>` definition appears anywhere in the
# global-flag prefix, "" otherwise). Real git honors such a definition for
# THIS invocation only -- e.g. `git -c alias.wip=push wip origin master`
# expands `wip` to `push` and pushes, with no trace in ~/.gitconfig -- and a
# legitimate dispatch-pipeline command line has no reason to define an
# ad-hoc alias inline, so this is a hard reject regardless of what the
# alias's value actually is (see the git wrapper script below), rather than
# an attempt to resolve and evaluate it: the value could itself be a shell
# alias (`!...`) or reference other config in ways not safe to statically
# evaluate here.
_interactive_guard_git_find_subcommand() {
    _interactive_guard_subcommand=""
    _interactive_guard_subcommand_args=()
    _interactive_guard_global_prefix=()
    _interactive_guard_git_oneshot_alias=""
    local arg
    while [ $# -gt 0 ]; do
        arg="$1"
        case "$arg" in
            -c|--config-env)
                # [ROUND 5] `-c alias.<name>=<value>` / `--config-env
                # alias.<name>=<ENVVAR>` define a git alias for THIS
                # invocation only, on the command line itself (see
                # `_interactive_guard_git_oneshot_alias` note below for why
                # this is flagged rather than resolved). Both forms only
                # take a space-separated value in real git (confirmed live
                # against git 2.43 -- see the function-level comment above).
                if [ $# -ge 2 ]; then
                    case "$2" in
                        alias.*) _interactive_guard_git_oneshot_alias=1 ;;
                    esac
                    _interactive_guard_global_prefix+=("$arg" "$2")
                    shift 2
                else
                    shift
                fi
                ;;
            -C|--git-dir|--work-tree|--namespace|--list-cmds|--attr-source)
                if [ $# -ge 2 ]; then
                    _interactive_guard_global_prefix+=("$arg" "$2")
                    shift 2
                else
                    shift
                fi
                ;;
            --config-env=*)
                case "$arg" in
                    --config-env=alias.*) _interactive_guard_git_oneshot_alias=1 ;;
                esac
                _interactive_guard_global_prefix+=("$arg")
                shift
                ;;
            --git-dir=*|--work-tree=*|--namespace=*|--list-cmds=*|--attr-source=*|--exec-path=*)
                _interactive_guard_global_prefix+=("$arg")
                shift
                ;;
            --exec-path)
                _interactive_guard_global_prefix+=("$arg")
                shift
                ;;
            *)
                if _interactive_guard_git_global_noarg "$arg"; then
                    _interactive_guard_global_prefix+=("$arg")
                    shift
                elif [ "${arg#-}" != "$arg" ]; then
                    # Unrecognized flag before any subcommand token -- not a
                    # global-option form `man git` documents for this git
                    # version. Real git itself rejects unknown global
                    # options ("unknown option: ...") before ever running a
                    # subcommand, and the wrapper always execs the ORIGINAL,
                    # untouched argv regardless of what this scan decides --
                    # so leaving detection empty here creates no bypass; see
                    # KNOWN LIMITATIONS in the installer file.
                    return
                else
                    _interactive_guard_subcommand="$arg"
                    shift
                    _interactive_guard_subcommand_args=("$@")
                    return
                fi
                ;;
        esac
    done
}

# [ROUND 5] git: resolve ONE level of a PERSISTENT git alias -- an
# `[alias]` entry already sitting in ~/.gitconfig (or a repo-local
# .git/config), as opposed to the one-shot `-c alias.*=` form handled by the
# hard reject above. `_interactive_guard_git_find_subcommand()` only ever
# sees the literal token the caller typed; if that token is itself an alias
# name (e.g. `[alias] wip = push` then `git wip origin master`), the
# subcommand-detection above reports "wip", which does not literally match
# "push", and the invocation would pass through unblocked even though real
# git expands it to an actual push -- this is the persistent-alias half of
# the round-4-review bypass (the other half is the one-shot `-c` form
# rejected above). Real git resolves this by looking up `alias.<name>` via
# its own config machinery (which layers repo-local, global, and system
# config); this function asks the REAL git binary for that same answer via
# `git config --get-regexp '^alias\.'` (forwarding any -C/--git-dir/
# --work-tree that were skipped over, so an aliased subcommand is resolved
# against the SAME config git itself would use for this invocation) rather
# than re-implementing git's config-layering rules.
#
# Only resolves ONE level: if the alias's value is itself another alias
# name, or begins with `!` (a shell alias -- an arbitrary shell command, not
# a git subcommand token at all), this function leaves
# _interactive_guard_effective_subcommand as the literal alias name
# unresolved rather than guessing -- see KNOWN LIMITATIONS in the installer
# file for why both are disclosed as residual gaps rather than silently
# assumed safe.
#
# Call as: _interactive_guard_git_resolve_persistent_alias <real-git-argv...>
# -- <subcommand> <subcommand-args...>. Sets
# _interactive_guard_effective_subcommand (the alias's first expansion
# token, or the original subcommand unchanged if it is not a known,
# resolvable alias) and _interactive_guard_subcommand_args_effective (the
# alias's remaining expansion tokens followed by the original subcommand
# args, matching how real git substitutes an alias in place of the typed
# name).
_interactive_guard_git_resolve_persistent_alias() {
    local real_git_argv=()
    while [ "$1" != "--" ]; do
        real_git_argv+=("$1")
        shift
    done
    shift
    local subcommand="$1"
    shift
    _interactive_guard_effective_subcommand="$subcommand"
    _interactive_guard_subcommand_args_effective=("$@")
    local line key value name
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        key="${line%% *}"
        if [ "$key" = "$line" ]; then
            value=""
        else
            value="${line#* }"
        fi
        name="${key#alias.}"
        if [ "$name" = "$subcommand" ]; then
            case "$value" in
                ''|'!'*)
                    # empty (malformed) or a shell alias -- cannot be
                    # resolved to a subcommand token; leave unresolved (see
                    # KNOWN LIMITATIONS).
                    return
                    ;;
            esac
            local expansion_tokens=($value)
            _interactive_guard_effective_subcommand="${expansion_tokens[0]}"
            _interactive_guard_subcommand_args_effective=("${expansion_tokens[@]:1}" "$@")
            return
        fi
    done < <("${real_git_argv[@]}" config --get-regexp '^alias\.' 2>/dev/null)
}

# git: sets _interactive_guard_push_verdict to "" (allow) or a label
# describing the protected ref this push argv (the args *after* "push")
# would reach, for the args of a `git push` invocation. `--all`/`--mirror`
# push every ref -- including protected branches -- regardless of the
# current checked-out branch, so they are always flagged without needing to
# resolve a single destination branch.
#
# `git push [<repository> [<refspec>...]]` accepts MULTIPLE refspecs in one
# invocation (e.g. `git push origin feature-branch master` pushes both in a
# single push) -- every positional arg after the repository name is a
# refspec of its own and must be checked; checking only the first one lets a
# protected branch riding alongside a feature branch through unblocked
# (round-3 fix, reproduced live). A leading `+` on a refspec is git's
# force-push marker (e.g. `+master`, `+master:master`) and belongs to the
# refspec as a whole, not to either side of a `:` -- it must be stripped
# before comparison, or `git push origin +master` evaluates dest as the
# literal string "+master" and never matches (round-3 fix, reproduced live).
#
# [ROUND 4] Call as: _interactive_guard_git_push_verdict <real-git-argv...>
# -- <push-args...>. The args before the literal `--` sentinel are the full
# real-git invocation prefix to use if a bare `git push` needs to resolve
# the current branch (the real git binary's path, plus any global flags
# like -C/--git-dir/--work-tree that were skipped over to find "push" in
# the original command line -- carrying them forward here means `git -C
# /some/other/repo push` resolves the current branch INSIDE that repo, not
# the wrapper's own cwd). The args after `--` are everything the original
# command line had after "push" itself.
_interactive_guard_git_push_verdict() {
    local real_git_argv=()
    while [ "$1" != "--" ]; do
        real_git_argv+=("$1")
        shift
    done
    shift
    local args=("$@") positional=() arg refspec dest
    for arg in "${args[@]}"; do
        case "$arg" in
            --all|--mirror)
                _interactive_guard_push_verdict="all refs (push $arg)"
                return
                ;;
            -*) ;;
            *) positional+=("$arg") ;;
        esac
    done
    _interactive_guard_push_verdict=""
    if [ "${#positional[@]}" -ge 2 ]; then
        for refspec in "${positional[@]:1}"; do
            refspec="${refspec#+}"
            dest="${refspec##*:}"
            dest="${dest#refs/heads/}"
            case "$dest" in
                master|main)
                    _interactive_guard_push_verdict="$dest"
                    return
                    ;;
            esac
        done
        return
    fi
    dest="$("${real_git_argv[@]}" symbolic-ref --short HEAD 2>/dev/null)"
    dest="${dest#refs/heads/}"
    case "$dest" in
        master|main) _interactive_guard_push_verdict="$dest" ;;
    esac
}
LIB_EOF

# --- git wrapper script -----------------------------------------------------
cat > "$_interactive_guard_dir/git" <<'GIT_EOF'
#!/bin/bash
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_dir/_lib.sh"

_real_git="$(_interactive_guard_real_bin git)"
if [ -z "$_real_git" ]; then
    echo "interactive-session-guard: real git binary not found on PATH" >&2
    exit 127
fi

_interactive_guard_git_find_subcommand "$@"

# [ROUND 5] A one-shot `-c alias.*=`/`--config-env=alias.*` definition on
# the command line itself is a hard reject regardless of subcommand or
# worker context bypass state below being reached -- see
# _interactive_guard_git_oneshot_alias's definition in _lib.sh for why this
# is rejected outright rather than resolved.
if [ -n "$_interactive_guard_git_oneshot_alias" ] && ! _interactive_guard_is_real_worker_context; then
    echo "BLOCKED: git invocation defines a one-shot alias on the command line (-c alias.*=/--config-env=alias.*) -- this cannot be distinguished from an attempt to disguise a guarded subcommand (e.g. 'git -c alias.wip=push wip origin master'), so it is rejected outright; run the real subcommand directly, or go through the dispatch pipeline (task-gateway.py) -- see ai-os/OWNER_DIRECTIVES/PROTOCOL_OWNER_AI.yaml" >&2
    exit 1
fi

# [ROUND 5] If the detected subcommand isn't literally "push", it might
# still BE push via a persistent `[alias]` entry in ~/.gitconfig (e.g.
# `alias.wip = push` then `git wip ...`) -- resolve one level before
# deciding it's not a push.
_interactive_guard_effective_subcommand="$_interactive_guard_subcommand"
_interactive_guard_subcommand_args_effective=("${_interactive_guard_subcommand_args[@]}")
if [ -n "$_interactive_guard_subcommand" ] && [ "$_interactive_guard_subcommand" != "push" ]; then
    _interactive_guard_git_resolve_persistent_alias "$_real_git" "${_interactive_guard_global_prefix[@]}" -- "$_interactive_guard_subcommand" "${_interactive_guard_subcommand_args[@]}"
fi

if [ "$_interactive_guard_effective_subcommand" = "push" ] && ! _interactive_guard_is_real_worker_context; then
    _interactive_guard_git_push_verdict "$_real_git" "${_interactive_guard_global_prefix[@]}" -- "${_interactive_guard_subcommand_args_effective[@]}"
    if [ -n "$_interactive_guard_push_verdict" ]; then
        echo "BLOCKED: git push to protected branch/ref '$_interactive_guard_push_verdict' must run through the dispatch pipeline (task-gateway.py), not an interactive session -- see ai-os/OWNER_DIRECTIVES/PROTOCOL_OWNER_AI.yaml" >&2
        exit 1
    fi
fi
exec "$_real_git" "$@"
GIT_EOF
chmod +x "$_interactive_guard_dir/git"

# --- gh wrapper script -------------------------------------------------------
cat > "$_interactive_guard_dir/gh" <<'GH_EOF'
#!/bin/bash
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_dir/_lib.sh"

_real_gh="$(_interactive_guard_real_bin gh)"
if [ -z "$_real_gh" ]; then
    echo "interactive-session-guard: real gh binary not found on PATH" >&2
    exit 127
fi

_interactive_guard_gh_strip_globals "$@"

# [ROUND 5] If the (post-global-flag-strip) argv isn't already a literal
# `pr merge`/merge-API call, it might still BE one via a persistent alias
# (e.g. `gh alias set mrg 'pr merge --merge'` then `gh mrg 1`) -- resolve
# one level before deciding it's not a merge.
_interactive_guard_gh_effective=("${_interactive_guard_gh_stripped[@]}")
if ! _interactive_guard_gh_is_merge "${_interactive_guard_gh_stripped[@]}"; then
    _interactive_guard_gh_resolve_persistent_alias "$_real_gh" "${_interactive_guard_gh_stripped[@]}"
    _interactive_guard_gh_effective=("${_interactive_guard_gh_resolved[@]}")
fi

if ! _interactive_guard_is_real_worker_context && _interactive_guard_gh_is_merge "${_interactive_guard_gh_effective[@]}"; then
    echo "BLOCKED: gh pr merge (including the equivalent gh api PUT/PATCH .../pulls/N/merge call) must run through the dispatch pipeline (task-gateway.py), not an interactive session -- see ai-os/OWNER_DIRECTIVES/PROTOCOL_OWNER_AI.yaml" >&2
    exit 1
fi
exec "$_real_gh" "$@"
GH_EOF
chmod +x "$_interactive_guard_dir/gh"

# --- put the guard scripts earlier on PATH than the real binaries ----------
case ":$PATH:" in
    *":$_interactive_guard_dir:"*) ;;
    *) export PATH="$_interactive_guard_dir:$PATH" ;;
esac
hash -r 2>/dev/null

unset _interactive_guard_dir
# === end interactive-session write gate =================================
