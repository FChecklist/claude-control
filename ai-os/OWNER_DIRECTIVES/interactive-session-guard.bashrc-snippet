cat > "$_interactive_guard_dir/gh" <<'GH_EOF'
#!/bin/bash
_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$_dir/_lib.sh"

_real_gh="$(_interactive_guard_real_bin gh)"
if [ -z "$_real_gh" ]; then
