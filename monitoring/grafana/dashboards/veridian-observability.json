{
  "title": "VERIDIAN Host Observability",
  "uid": "veridian-observability",
  "tags": ["veridian", "task-20260814-131031"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory & Swap Used %",
      "description": "100 * (1 - available/total) for RAM; (total-free)/total for swap. Source: node_exporter.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "mem used %"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
          "expr": "(node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes) / clamp_min(node_memory_SwapTotal_bytes, 1) * 100",
          "legendFormat": "swap used %"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Load Average (1m, normalized by CPU count) %",
      "description": "node_load1 / cpu_count * 100. Source: node_exporter.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": { "lineWidth": 2, "fillOpacity": 10, "drawStyle": "line" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
          "expr": "node_load1 / scalar(count(node_cpu_seconds_total{mode=\"idle\"})) * 100",
          "legendFormat": "load1 %"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Real Concurrent Worker Count",
      "description": "Running veridian-worker@* + veridian-supervisor@* systemd --user units. Source: veridian-metrics-textfile.timer (read-only, no dispatch coupling).",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 4 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
          "expr": "veridian_concurrent_worker_count"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Dispatch Queue Depth",
      "description": "superboss-register.sqlite work_items rows with status IN ('open','pending'). Source: veridian-metrics-textfile.timer (read-only, no dispatch coupling).",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "veridian-prometheus" },
          "expr": "veridian_dispatch_queue_depth"
        }
      ]
    }
  ]
}
